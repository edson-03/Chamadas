# Servidor
PORT=3000
NODE_ENV=production

# Chave secreta JWT para autenticação administrativa
JWT_SECRET=sua-chave-secreta-aqui

# Credenciais do administrador (altere no primeiro deploy)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$10$...senha-em-hash...

# Configuração do Google Sheets
GOOGLE_SHEETS_ID=id-da-sua-planilha-aqui
GOOGLE_SERVICE_ACCOUNT_EMAIL=sua-conta-de-servico@projeto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# URL da aplicação (usada para gerar links das chamadas)
APP_URL=http://localhost:3000
